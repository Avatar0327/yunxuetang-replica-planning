+<!doctype html><html lang="zh-CN"><meta charset="UTF-8"><title>云学堂 · 权限预研</title><link rel="stylesheet" href="/assets/element.css"><style>body{margin:0;background:#f4f6fa;color:#18243b;font:15px system-ui}header{padding:24px 40px;background:white;border-bottom:1px solid #e4e8ef}main{max-width:1050px;margin:36px auto}.box{padding:28px;background:white;border-radius:12px;margin:20px 0}h1{font-size:26px}small{color:#66758a}.controls{display:flex;gap:12px;align-items:center}</style><div id="app"><header>云学堂 <small>权限预研 · 合成数据</small></header><main><h1>{{caps.backend?'管理后台':'学习中心'}}</h1><div class="controls"><el-select v-model="actor" @change="refresh" style="width:200px"><el-option v-for="id in ['L','M','X','Y','Z']" :label="'测试身份 '+id" :value="id"/></el-select><el-button @click="refresh">刷新权限</el-button></div><div v-if="error" class="box"><el-result icon="warning" title="暂时无法访问" :sub-title="error"><template #extra><el-button @click="refresh">重试</el-button><el-button @click="learner=true">返回学员端</el-button></template></el-result></div><div v-else-if="!caps.backend||learner" class="box"><el-empty description="当前没有管理任务，你可以继续学习。"/></div><template v-else><div class="box"><el-tag v-for="n in caps.nodes" style="margin-right:8px">{{n==='project'?'培训中心':'学习报表'}}</el-tag></div><div class="box" v-if="caps.nodes.includes('project')"><h2>培训中心</h2><el-empty v-if="!projects.length" description="当前没有可管理的项目"/><el-table v-else :data="projects"><el-table-column prop="title" label="项目"/><el-table-column label="操作"><template #default="s"><el-button @click="open(s.row.id)">查看</el-button></template></el-table-column></el-table></div></template><div class="box" v-if="detail">{{detail}}</div></main></div><script src="/assets/vue.js"></script><script src="/assets/element.js"></script><script>Vue.createApp({data:()=>({actor:'L',caps:{backend:false,nodes:[]},projects:[],error:'',detail:'',learner:false}),methods:{async api(path){let r=await fetch(path,{headers:{Authorization:'Bearer spike-'+this.actor}});let x=await r.json();if(!r.ok)throw Error(x.message);return x},async refresh(){this.error='';this.projects=[];this.detail='';this.learner=false;try{this.caps=(await this.api('/auth/me')).capabilities;if(this.caps.nodes.includes('project'))this.projects=(await this.api('/projects')).rows;}catch(e){this.caps={backend:false,nodes:[]};this.error=e.message}},async open(id){try{this.detail=(await this.api('/projects/'+id)).rows[0].title}catch(e){this.detail='';this.error=e.message}}},mounted(){this.refresh()}}).use(ElementPlus).mount('#app')</script></html>
