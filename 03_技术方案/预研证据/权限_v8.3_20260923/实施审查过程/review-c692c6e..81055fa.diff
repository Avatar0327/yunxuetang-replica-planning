+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+spike_output="${1:-evidence/raw/runtime}"
+mkdir -p "$spike_output"
+spike_docker() { docker --context colima-yxt-permission "$@"; }
